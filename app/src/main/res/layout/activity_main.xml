<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/nav_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:padding="8dp">

        <Button
            android:id="@+id/btn_home"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="🏠"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_add_favorite"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="♡"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_view_favorites"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="📚"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_downloads"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="⬇"
            android:textSize="18sp" />

    </LinearLayout>

    <!-- Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:visibility="gone"
        android:progressTint="#BB86FC"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 右下角操作：複製目前網址；跨站搜尋在其上方，互不遮擋。 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_copy_page_url"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:elevation="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:contentDescription="複製目前網頁網址"
        android:text=""
        android:visibility="gone"
        app:icon="@drawable/ic_copy_page_url"
        app:iconSize="24dp"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:iconTint="#24152B"
        app:backgroundTint="#BB86FC"
        app:cornerRadius="26dp"
        app:layout_constraintBottom_toTopOf="@id/tv_footer_github"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cross_site_search"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:elevation="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:contentDescription="跨站搜尋"
        android:text=""
        android:visibility="gone"
        app:icon="@drawable/ic_unified_search"
        app:iconSize="24dp"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:iconTint="#24152B"
        app:backgroundTint="#BB86FC"
        app:cornerRadius="26dp"
        app:layout_constraintBottom_toTopOf="@id/btn_copy_page_url"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Play Button (Top Right, visible when video detected) -->
    <Button
        android:id="@+id/btn_play"
        android:layout_width="56dp"
        android:layout_height="40dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:contentDescription="播放影片"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="▶"
        android:textSize="18sp"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_settings" />

    <!-- Settings Button (Top Right Corner) -->
    <Button
        android:id="@+id/btn_settings"
        android:layout_width="48dp"
        android:layout_height="40dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="⚙️"
        android:textSize="18sp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        layout="@layout/include_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 全螢幕影片容器：onShowCustomView 時覆蓋整個畫面 -->
    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
