<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/seven_playback_preview"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_seven_cover" android:clipToOutline="true">
        <ImageView android:id="@+id/iv_seven_detail_cover"
            android:layout_width="0dp" android:layout_height="0dp" android:scaleType="fitCenter"
            android:background="#000000" android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintDimensionRatio="H,16:9" />
        <ImageButton android:id="@+id/btn_seven_detail_play"
            android:layout_width="64dp" android:layout_height="64dp" android:padding="16dp"
            android:background="@drawable/bg_seven_round_button" android:src="@drawable/ic_seven_play"
            app:layout_constraintStart_toStartOf="@id/iv_seven_detail_cover" app:layout_constraintEnd_toEndOf="@id/iv_seven_detail_cover"
            app:layout_constraintTop_toTopOf="@id/iv_seven_detail_cover" app:layout_constraintBottom_toBottomOf="@id/iv_seven_detail_cover" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView android:id="@+id/tv_seven_detail_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/tv_seven_detail_metadata"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="#AAAAAA" android:textSize="13sp" />
    <TextView android:id="@+id/tv_seven_detail_description_label"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/tv_seven_detail_description"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="#CCCCCC" android:textSize="15sp" android:lineSpacingExtra="4dp" />
    <FrameLayout android:id="@+id/seven_server_selection"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
</LinearLayout>
