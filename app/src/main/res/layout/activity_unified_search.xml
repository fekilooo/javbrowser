<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="#1E1E1E">

        <Button
            android:id="@+id/btn_unified_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:text="← 返回"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:backgroundTint="#333333" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="統一跨站搜尋"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_unified_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:text="停止"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone"
            android:backgroundTint="#7B1FA2" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_unified_run_mode"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:text="流暢瀏覽 · 首頁優先"
        android:textAllCaps="false"
        android:textSize="11sp"
        android:textColor="#24152B"
        android:backgroundTint="#9C6ADE" />

    <LinearLayout
        android:id="@+id/unified_query_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_unified_query"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="#BB86FC"
            android:hint="輸入番號或關鍵字"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#999999" />

        <Button
            android:id="@+id/btn_unified_search"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:minHeight="0dp"
            android:text="搜尋"
            android:textColor="#24152B"
            android:textSize="13sp"
            android:backgroundTint="#BB86FC" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_unified_query_mode"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:text="查詢模式：自動辨識"
        android:textAllCaps="false"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#333333" />

    <Button
        android:id="@+id/btn_unified_sort_mode"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:text="排序：相關性"
        android:textAllCaps="false"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#333333" />

    <LinearLayout
        android:id="@+id/unified_selection_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:gravity="center_vertical">
        <Button
            android:id="@+id/btn_unified_select_all"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="0dp"
            android:text="全選網站"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333" />
        <Button
            android:id="@+id/btn_unified_clear_sites"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:minHeight="0dp"
            android:text="清除網站"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/unified_site_chooser_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">
        <LinearLayout
            android:id="@+id/unified_site_chooser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <Button
            android:id="@+id/btn_unified_toggle_controls"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:insetTop="4dp"
            android:insetBottom="4dp"
            android:text="收合設定與站點 ▴"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="#24152B"
            android:backgroundTint="#BB86FC" />
        <Spinner
            android:id="@+id/spinner_unified_source"
            android:layout_width="128dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="篩選搜尋結果來源"
            android:backgroundTint="#BB86FC" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <Button
            android:id="@+id/btn_unified_save_search"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="儲存搜尋"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="#24152B"
            android:backgroundTint="#BB86FC" />
        <Button
            android:id="@+id/btn_unified_saved_searches"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="已存搜尋"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="#24152B"
            android:backgroundTint="#BB86FC" />
    </LinearLayout>
    <TextView
        android:id="@+id/tv_unified_saved_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textSize="11sp"
        android:textColor="#FFCC80"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_unified_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:gravity="center"
        android:text="輸入內容後按搜尋"
        android:textColor="#BB86FC"
        android:textSize="12sp"
        android:background="#1A1A1A" />

    <ProgressBar
        android:id="@+id/progress_unified"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:progressTint="#BB86FC"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_unified_continue_pages"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="繼續抓取後續頁"
        android:textSize="12sp"
        android:textColor="#24152B"
        android:backgroundTint="#BB86FC"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_unified_copy_diagnostics"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:minHeight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="複製診斷"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#333333" />

    <Button
        android:id="@+id/btn_unified_resume"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="繼續未完成站點"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/unified_site_status_scroll"
        android:layout_width="match_parent"
        android:layout_height="200dp">
      <LinearLayout
        android:id="@+id/unified_site_statuses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp" />
    </ScrollView>

    <TextView
        android:id="@+id/tv_unified_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:gravity="center"
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_unified_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="10dp" />
</LinearLayout>
