<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:maxLines="3"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:gravity="top">

            <CheckBox
                android:id="@+id/cb_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:clickable="false"
                android:focusable="false"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="128dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:background="@android:color/darker_gray">

                <ImageView
                    android:id="@+id/iv_thumbnail_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.45"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Video Thumbnail" />

                <Button
                    android:id="@+id/btn_repair_cover"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="start|top"
                    android:layout_margin="5dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="↻"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#B0000000"
                    android:contentDescription="修復封面"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_local_play"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_gravity="end|bottom"
                    android:layout_margin="6dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="▶"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#B0000000"
                    android:visibility="gone" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_actors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#C2185B"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="10sp"
                    android:textColor="#757575"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_genres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="10sp"
                    android:textColor="#1976D2"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_live_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_stripchat_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="10sp"
                    android:textColor="#424242"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.08"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_custom_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="10sp"
                    android:textColor="#006064"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="10sp"
                    android:textColor="#6D4C41"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_edit_favorite"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Edit"
                    android:textSize="11sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_delete"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:src="@android:drawable/ic_menu_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tv_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@android:color/darker_gray"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_platform_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:gravity="center_vertical"
            android:background="@drawable/platform_chips_bg"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/ll_stripchat_recordings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/hsv_chips"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/chip_jable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="J"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/chip_bg_green"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chip_7mmtv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7M"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/chip_bg_orange"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chip_avple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AP"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/chip_bg_purple"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chip_whos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WH"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/chip_bg_teal"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chip_pigav"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/chip_bg_teal"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chip_avtoday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AT"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/chip_bg_red"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chip_missav"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="M"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/chip_bg_blue"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chip_missav_uncensored"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MU"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/chip_bg_orange"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chip_missav_chinese"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MC"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/chip_bg_purple"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chip_avjoy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Y"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/chip_bg_red"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chip_avjoy_chinese"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YC"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/chip_bg_teal"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chip_javhd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="H"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/chip_bg_blue"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chip_javhd_uncensored"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HU"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/chip_bg_orange"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chip_javhd_chinese"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HC"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/chip_bg_purple"
                        android:visibility="gone" />

                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/btn_retry_crosssite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↻"
                android:textSize="15sp"
                android:textColor="#888888"
                android:alpha="0.5"
                android:paddingStart="4dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
