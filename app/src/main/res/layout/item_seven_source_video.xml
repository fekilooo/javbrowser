<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="6dp" android:layout_marginBottom="12dp"
    android:background="?attr/selectableItemBackground" android:focusable="true" android:clickable="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_seven_cover" android:clipToOutline="true">
        <ImageView android:id="@+id/iv_seven_cover"
            android:layout_width="0dp" android:layout_height="0dp" android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintDimensionRatio="H,2:3" />
        <TextView android:id="@+id/tv_seven_duration"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:padding="8dp" android:textColor="#FFFFFF" android:textSize="12sp"
            android:background="#80000000" android:maxLines="1" android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/iv_seven_cover" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView android:id="@+id/tv_seven_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="#FFFFFF" android:textSize="14sp"
        android:textStyle="bold" android:minLines="2" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/tv_seven_source"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#999999" android:textSize="12sp" />
</LinearLayout>
