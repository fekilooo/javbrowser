<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#1E1E1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <!-- Thumbnail：直式封面，依 119x162 原比例顯示，不裁切 -->
        <ImageView
            android:id="@+id/iv_today_thumb"
            android:layout_width="73dp"
            android:layout_height="99dp"
            android:scaleType="fitCenter"
            android:background="#333333"
            android:layout_marginEnd="10dp" />

        <!-- Text info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_today_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.1" />

            <TextView
                android:id="@+id/tv_today_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#BB86FC"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Bookmark / cross-site search buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:orientation="vertical">
            <Button
                android:id="@+id/btn_today_bookmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚"
                android:textSize="18sp"
                android:minWidth="0dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:backgroundTint="#333333" />
            <Button
                android:id="@+id/btn_today_cross_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="🔍"
                android:textSize="18sp"
                android:minWidth="0dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:contentDescription="跨站搜尋"
                android:backgroundTint="#493060" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
